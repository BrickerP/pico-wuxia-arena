  "assumptions": [
    {
      "id": "ASM-INPUT",
      "statement": "左右键仅代理抓握拾取，攻击仍短方向意图；单把主武器，未真实双持/真机接线。",
      "impact": "high",
      "status": "confirmed",
      "validation": "index.html监听mousedown/up和pointermove，无键盘攻击。"
    },
    {
      "id": "ASM-ART",
      "statement": "三Boss复用旧GLB缩放、原刀；剑枪棍程序占位，动画三槽资源为空。",
      "impact": "high",
      "status": "confirmed",
      "validation": "battle-core.js及index.html createWeaponVisual、enemyPose、animation slots。"
    },
    {
      "id": "ASM-QUALITY",
      "statement": "局部玩法通过，未完整三轮/小径/护手/另一模型及各武器全姿态验收，非3A或VR物理。",
      "impact": "high",
      "status": "confirmed",
      "validation": "final4综合/防守/反投处决/失败重开四份真实日志；完整路径及真机未验收。"
    }
  ],
  "rules": [
    {
      "id": "RULE-GESTURE",
      "title": "方向与握持",
      "definition": "新手势一招，释放65%后单缓存550ms，收势90ms后链接，链接起手120ms直连当前姿态，释放速度不变；起手收势匹配来刀可转守，实体受阻仍消费招。",
      "priority": "P0",
      "parameter_ids": [],
      "state_machine_ids": [
        "SM-MOVE"
      ],
      "authority_ids": [],
      "fields": [
        "demo.gesture"
      ]
    },
    {
      "id": "RULE-PRECISION",
      "title": "敌我精度与霸体",
      "definition": "玩家100精度，格挡18/化劲5/受击22/抓中30，静止停止攻防.6s后恢复16/s；空条1.1s不能攻防可步行；敌空条2.2s处决机会，恢复55%。霸体不免伤，轻击不中断但累积压力，空条覆盖霸体。",
      "priority": "P0",
      "parameter_ids": [],
      "state_machine_ids": [
        "SM-PRECISION"
      ],
      "authority_ids": [],
      "fields": [
        "demo.precision"
      ]
    },
    {
      "id": "RULE-WEAPON",
      "title": "旁侧兵器架",
      "definition": "刀剑枪棍右侧架上0.95m间隔，横向距离1.6m内指向握点55px选中拾取，单主武器、新拾旧物归架；空手敌人等待至拾武器后开战。",
      "priority": "P0",
      "parameter_ids": [],
      "state_machine_ids": [
        "SM-MOVE"
      ],
      "authority_ids": [],
      "fields": [
        "demo.weapon"
      ]
    },
    {
      "id": "RULE-GRAB",
      "title": "反投及动画槽",
      "definition": "红投技普通挡无效，离线躲；前摇末380ms或释放前140ms内新的双手前伸合抱可反，范围1.8m/未破防/敌攻击未结算。双鼠标握持短下划代理，动画boss_grab/counter_grab/execute三互斥空槽，暂停重开终局取消。",
      "priority": "P0",
      "parameter_ids": [],
      "state_machine_ids": [
        "SM-SLOT"
      ],
      "authority_ids": [],
      "fields": [
        "demo.grab"
      ]
    },
    {
      "id": "RULE-SLOW",
      "title": "有限敌方反应慢动作",
      "definition": "白.65倍300ms、蓝.45倍320ms、红.40倍650ms，每敌攻击/色一次；仅敌更新减速，玩家与精度计时实时、真机头追踪不减速，可关。",
      "priority": "P0",
      "parameter_ids": [],
      "state_machine_ids": [
        "SM-SESSION"
      ],
      "authority_ids": [],
      "fields": [
        "demo.slow"
      ]
    },
    {
      "id": "RULE-BOSS",
      "title": "Boss硬度与弱点",
      "definition": "剑客180/72/.9化劲×1.6；枪卫235/100/1.25收势×1.8；巨擂300/140/1.8棍×2。体型.96/1.10/1.26，同模型占位。",
      "priority": "P0",
      "parameter_ids": [],
      "state_machine_ids": [
        "SM-PRECISION"
      ],
      "authority_ids": [],
      "fields": [
        "demo.boss"
      ]
    },
    {
      "id": "RULE-CONTACT",
      "title": "实体接触",
      "definition": "继续薄盒旋转扫掠实体接触与受阻、格挡方向匹配；长枪身体伤害只尖端28cm、棍钝击无刃向，未成熟有限力引擎。",
      "priority": "P0",
      "parameter_ids": [],
