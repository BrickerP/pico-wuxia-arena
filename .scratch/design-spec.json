  "transitions": [
    {
      "id": "start-trial",
      "from": "ready",
      "to": "fighting",
      "trigger": {
        "nodeId": "start-button",
        "event": "click-action"
      }
    },
    {
      "id": "pause-trial",
      "from": "fighting",
      "to": "paused",
      "trigger": {
        "nodeId": "pause-button",
        "event": "click-action"
      }
    },
    {
      "id": "resume-trial",
      "from": "paused",
      "to": "fighting",
      "trigger": {
        "nodeId": "resume-button",
        "event": "click-action"
      }
    },
    {
      "id": "tracking-interrupted",
      "from": "fighting",
      "to": "tracking-lost",
      "trigger": {
        "nodeId": "status-root",
        "event": "tracking-lost"
      }
    },
    {
      "id": "tracking-restored",
      "from": "tracking-lost",
      "to": "tracking-resume-ready",
      "trigger": {
        "nodeId": "status-root",
        "event": "tracking-restored"
      }
    },
    {
      "id": "confirm-tracking-resume",
      "from": "tracking-resume-ready",
      "to": "fighting",
      "trigger": {
        "nodeId": "resume-tracking-button",
        "event": "click-action"
      }
    },
    {
      "id": "reset-from-tracking-ready",
      "from": "tracking-resume-ready",
      "to": "ready",
      "trigger": {
        "nodeId": "reset-tracking-ready-button",
        "event": "click-action"
      },
      "confirmation": {
        "title": "重新开局？",
        "body": "追踪已恢复，但当前试炼进度仍将清除。",
        "confirmLabel": "重新开局",
        "cancelLabel": "继续试炼"
      }
    },
    {
      "id": "enemy-defeated",
      "from": "fighting",
      "to": "defeated",
      "trigger": {
        "nodeId": "status-root",
        "event": "enemy-defeated"
      }
    },
    {
      "id": "reset-from-fighting",
      "from": "fighting",
      "to": "ready",
      "trigger": {
        "nodeId": "reset-fighting-button",
        "event": "click-action"
      },
      "confirmation": {
        "title": "重新开局？",
        "body": "当前试炼进度将清除，双方回到初始状态。",
        "confirmLabel": "重新开局",
        "cancelLabel": "继续试炼"
      }
    },
    {
      "id": "reset-from-paused",
      "from": "paused",
      "to": "ready",
      "trigger": {
        "nodeId": "reset-paused-button",
        "event": "click-action"
      },
      "confirmation": {
        "title": "重新开局？",
        "body": "当前试炼进度将清除，双方回到初始状态。",
        "confirmLabel": "重新开局",
        "cancelLabel": "保持暂停"
      }
    },
    {
      "id": "reset-from-tracking",
      "from": "tracking-lost",
      "to": "ready",
      "trigger": {
        "nodeId": "reset-tracking-button",
        "event": "click-action"
      },
      "confirmation": {
        "title": "重新开局？",
        "body": "追踪仍未恢复，当前试炼进度将清除。",
        "confirmLabel": "重新开局",
        "cancelLabel": "等待追踪"
      }
    },
    {
      "id": "reset-from-defeated",
      "from": "defeated",
      "to": "ready",
      "trigger": {
        "nodeId": "reset-defeated-button",
        "event": "click-action"
      },
      "confirmation": {
        "title": "再试一局？",
        "body": "刀客与试炼状态将回到初始位置。",
        "confirmLabel": "再试一局",
        "cancelLabel": "留在此处"
      }
    }
  ],
  "actions": [
    {
      "id": "start-action",
      "type": "transition",
      "purpose": "通过现有 tryStartAttack 接线开始试炼",
      "transitionId": "start-trial"
    },
    {
      "id": "pause-action",
      "type": "transition",
      "purpose": "调用现有 pauseByPlayer 进入用户暂停",
      "transitionId": "pause-trial"
    },
    {
      "id": "resume-action",
      "type": "transition",
      "purpose": "以当前 pauseId 和有效输入调用 tryResume",
      "transitionId": "resume-trial"
    },
    {
      "id": "tracking-loss-action",
