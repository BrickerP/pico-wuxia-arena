  "transitions": [
    {
      "id": "begin",
      "from": "start",
      "to": "preparing",
      "trigger": {
        "nodeId": "start-button",
        "event": "click-action"
      }
    },
    {
      "id": "cancel-prepare",
      "from": "preparing",
      "to": "start",
      "trigger": {
        "nodeId": "cancel-button",
        "event": "click-action"
      }
    },
    {
      "id": "tracking-ready",
      "from": "preparing",
      "to": "battle",
      "trigger": {
        "nodeId": "prepare-screen",
        "event": "tracking-ready"
      }
    },
    {
      "id": "tracking-interrupted",
      "from": "battle",
      "to": "paused",
      "trigger": {
        "nodeId": "arena-scene",
        "event": "tracking-interrupted"
      }
    },
    {
      "id": "manual-pause",
      "from": "battle",
      "to": "paused",
      "trigger": {
        "nodeId": "arena-scene",
        "event": "manual-pause"
      }
    },
    {
      "id": "resume-battle",
      "from": "paused",
      "to": "battle",
      "trigger": {
        "nodeId": "resume-button",
        "event": "click-action"
      }
    },
    {
      "id": "victory",
      "from": "battle",
      "to": "won",
      "trigger": {
        "nodeId": "arena-scene",
        "event": "victory"
      }
    },
    {
      "id": "defeat",
      "from": "battle",
      "to": "defeated",
      "trigger": {
        "nodeId": "arena-scene",
        "event": "defeat"
      }
    },
    {
      "id": "retry-won",
      "from": "won",
      "to": "preparing",
      "trigger": {
        "nodeId": "retry-won-button",
        "event": "click-action"
      }
    },
    {
      "id": "retry-defeated",
      "from": "defeated",
      "to": "preparing",
      "trigger": {
        "nodeId": "retry-defeated-button",
        "event": "click-action"
      }
    }
  ],
  "actions": [
    {
      "id": "begin-action",
      "type": "transition",
      "purpose": "开始准备追踪",
      "transitionId": "begin"
    },
    {
      "id": "cancel-action",
      "type": "transition",
      "purpose": "返回开场",
      "transitionId": "cancel-prepare"
    },
    {
      "id": "ready-action",
      "type": "transition",
      "purpose": "追踪连续有效并就绪后进入对局",
      "transitionId": "tracking-ready",
      "payload": {
        "requires": "tracking.canResume"
      }
    },
    {
      "id": "interrupt-action",
      "type": "transition",
      "purpose": "必要追踪失效或应用失去可用空间时停止裁决",
      "transitionId": "tracking-interrupted",
      "payload": {
        "dataCase": "fallback",
        "pauseReason": "tracking"
      }
    },
    {
      "id": "pause-action",
      "type": "transition",
      "purpose": "玩家主动暂停并冻结战斗时钟",
      "transitionId": "manual-pause",
      "payload": {
        "pauseReason": "manual"
      }
    },
    {
      "id": "paused-interrupt-action",
      "type": "set",
      "purpose": "暂停期间发生追踪失效或重定位，恢复改为取消敌招",
      "binding": "session.pauseReason",
      "value": "tracking",
      "payload": {
        "dataCase": "fallback"
      }
    },
    {
      "id": "resume-action",
      "type": "transition",
      "purpose": "追踪稳定后玩家主动继续；纯主动暂停保留敌人状态，出现追踪中断则取消敌招回待机",
      "transitionId": "resume-battle",
      "payload": {
        "requires": "tracking.canResume"
      }
    },
    {
      "id": "victory-action",
      "type": "transition",
      "purpose": "敌人被击败后显示结果",
      "transitionId": "victory"
    },
    {
      "id": "defeat-action",
      "type": "transition",
      "purpose": "玩家被击败后显示结果",
      "transitionId": "defeat"
    },
    {
      "id": "retry-won-action",
      "type": "transition",
      "purpose": "重新准备一局",
      "transitionId": "retry-won"
    },
    {
      "id": "retry-defeated-action",
      "type": "transition",
      "purpose": "重新准备一局",
      "transitionId": "retry-defeated"
    }
  ],
  "dataCases": {
    "normal": {
      "tracking": {
        "canResume": true,
        "prepareMessage": "追踪已就绪，准备入场。",
        "pauseMessage": "追踪已就绪，可以继续对局。"
      }
    },
    "fallback": {
      "tracking": {
        "canResume": false,
        "prepareMessage": "正在等待头显与持刀手柄追踪。",
        "pauseMessage": "正在等待头显与持刀手柄追踪。"
      }
    },
    "error": {
      "tracking": {
        "canResume": false,
        "prepareMessage": "追踪暂不可用，请确认设备连接与安全区域。",
        "pauseMessage": "追踪暂不可用，请确认设备连接与安全区域。"
      }
    }
  },
