      "transitionId": "tracking-restored"
    },
    {
      "id": "defeated-action",
      "type": "transition",
      "purpose": "敌人生命归零后显示试炼结束",
      "transitionId": "enemy-defeated"
    },
    {
      "id": "reset-fighting-action",
      "type": "transition",
      "purpose": "确认后调用 resetRound",
      "transitionId": "reset-from-fighting"
    },
    {
      "id": "reset-paused-action",
      "type": "transition",
      "purpose": "确认后调用 resetRound",
      "transitionId": "reset-from-paused"
    },
    {
      "id": "reset-tracking-action",
      "type": "transition",
      "purpose": "确认后调用 resetRound",
      "transitionId": "reset-from-tracking"
    },
    {
      "id": "reset-defeated-action",
      "type": "transition",
      "purpose": "确认后调用 resetRound",
      "transitionId": "reset-from-defeated"
    },
    {
      "id": "resume-tracking-action",
      "type": "transition",
      "purpose": "resumeReady为真后由玩家显式确认当前pauseId并调用tryResume",
      "transitionId": "confirm-tracking-resume"
    },
    {
      "id": "reset-tracking-ready-action",
      "type": "transition",
      "purpose": "确认后调用resetRound",
      "transitionId": "reset-from-tracking-ready"
    }
  ],
